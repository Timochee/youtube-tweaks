{
  "manifest_version": 3,
  "name": "YouTube Tweaks",
  "version": "1.0.0",
  "description": "Tweak YouTube: hide Shorts, live streams, live replays, and the algorithmic shelf, plus auto-like videos from subscribed channels.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "content/hide-shorts.js",
        "content/hide-live-streams.js",
        "content/hide-live-replays.js",
        "content/hide-most-relevant-shelf.js",
        "content/auto-like.js",
        "content/disable-autoplay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
